<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:allowBackup="false" android:label="KMADB"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@style/Theme.KMADB">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".service.OverlayService" android:exported="false" android:foregroundServiceType="specialUse"/>
        <service android:name=".engine.MemService" android:exported="true"
            android:permission="rikka.shizuku.permission.API_V23" tools:ignore="ExportedService"/>
        <provider android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.kmadb.ffmod2.shizuku" android:exported="true"
            android:multiprocess="false" android:enabled="true" android:directBootAware="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            tools:ignore="ProtectedPermissions"/>
    </application>
</manifest>
